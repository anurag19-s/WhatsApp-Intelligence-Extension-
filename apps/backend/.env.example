PORT=3000
HOST=127.0.0.1

# auto selects Anthropic when a key is set, otherwise the clearly labelled mock provider.
AI_PROVIDER=auto
AI_ALLOW_MOCK_FALLBACK=false
AI_TIMEOUT_MS=45000

# Copy this file to apps/backend/.env and set a valid key locally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
